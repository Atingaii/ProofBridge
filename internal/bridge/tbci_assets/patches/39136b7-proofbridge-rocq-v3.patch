diff --git a/internal/prover/rocq/project.go b/internal/prover/rocq/project.go
new file mode 100644
index 0000000..8e4892f
--- /dev/null
+++ b/internal/prover/rocq/project.go
@@ -0,0 +1,365 @@
+package rocq
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+type projectInvocation struct {
+	sourceRel       string
+	compileBase     []string
+	topArgs         []string
+	qualifiedModule string
+	mappings        []projectMapping
+}
+
+type projectMapping struct {
+	directory string
+	logical   string
+	flag      string
+}
+
+func rocqProjectInvocation(root, module string) (projectInvocation, error) {
+	sourceRel, err := uniqueRocqTargetSource(root, module)
+	if err != nil {
+		return projectInvocation{}, err
+	}
+	mappings, err := readCoqProjectMappings(root)
+	if err != nil {
+		return projectInvocation{}, err
+	}
+	if len(mappings) == 0 {
+		mappings = []projectMapping{{directory: ".", logical: "TBCI", flag: "-Q"}}
+	}
+	compileArgs := []string{"-q"}
+	topArgs := []string{"-quiet"}
+	qualified := ""
+	bestDepth := -1
+	for _, mapping := range mappings {
+		compileArgs = append(compileArgs, mapping.flag, mapping.directory, mapping.logical)
+		topArgs = append(topArgs, mapping.flag, mapping.directory, mapping.logical)
+		relFromMapping, ok := pathWithinMapping(sourceRel, mapping.directory)
+		if !ok {
+			continue
+		}
+		depth := strings.Count(filepath.ToSlash(mapping.directory), "/")
+		if depth < bestDepth {
+			continue
+		}
+		modulePath := strings.TrimSuffix(filepath.ToSlash(relFromMapping), ".v")
+		qualified = mapping.logical + "." + strings.ReplaceAll(modulePath, "/", ".")
+		bestDepth = depth
+	}
+	if qualified == "" {
+		return projectInvocation{}, fmt.Errorf("Rocq target source %s is outside every accepted _CoqProject mapping", sourceRel)
+	}
+	return projectInvocation{
+		sourceRel:       filepath.ToSlash(sourceRel),
+		compileBase:     compileArgs,
+		topArgs:         topArgs,
+		qualifiedModule: qualified,
+		mappings:        mappings,
+	}, nil
+}
+
+const (
+	maxRocqProjectSources = 512
+	maxRocqSourceBytes    = 2 * 1024 * 1024
+)
+
+var rocqRequire = regexp.MustCompile(`(?ms)(?:\bFrom\s+([[:alpha:]_][[:alnum:]_']*(?:\.[[:alpha:]_][[:alnum:]_']*)*)\s+)?\bRequire(?:\s+(?:Import|Export))?\s+(.+?)\.(?:\s|$)`)
+
+// compileRocqProject compiles only the target's verifier-derived local source
+// closure. It deliberately does not invoke a producer Makefile, dune file, or
+// command line from _CoqProject.
+func compileRocqProject(ctx context.Context, root, coqc string, invocation projectInvocation) (string, error) {
+	plan, err := rocqCompilePlan(root, invocation)
+	if err != nil {
+		return "", err
+	}
+	var targetOutput string
+	for _, sourceRel := range plan {
+		args := append(append([]string(nil), invocation.compileBase...), sourceRel)
+		output, err := commandIn(ctx, root, coqc, args...)
+		if err != nil {
+			return output, fmt.Errorf("compile %s: %w", sourceRel, err)
+		}
+		if sourceRel == invocation.sourceRel {
+			targetOutput = output
+		}
+	}
+	return targetOutput, nil
+}
+
+func rocqCompilePlan(root string, invocation projectInvocation) ([]string, error) {
+	type sourceNode struct {
+		rel     string
+		imports []string
+	}
+	byModule := make(map[string]sourceNode)
+	byRel := make(map[string]sourceNode)
+	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.IsDir() {
+			switch entry.Name() {
+			case ".git", ".tbci", ".codex-bridge", "_build":
+				if path != root {
+					return filepath.SkipDir
+				}
+			}
+			return nil
+		}
+		if !entry.Type().IsRegular() || filepath.Ext(entry.Name()) != ".v" {
+			return nil
+		}
+		if len(byRel) >= maxRocqProjectSources {
+			return fmt.Errorf("Rocq project exceeds %d source files", maxRocqProjectSources)
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		if info.Size() > maxRocqSourceBytes {
+			return fmt.Errorf("Rocq source %s exceeds %d bytes", entry.Name(), maxRocqSourceBytes)
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		rel = filepath.ToSlash(rel)
+		qualified, ok := qualifiedRocqSource(rel, invocation.mappings)
+		if !ok {
+			return nil
+		}
+		if previous, exists := byModule[qualified]; exists && previous.rel != rel {
+			return fmt.Errorf("Rocq module %s is ambiguous", qualified)
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		node := sourceNode{rel: rel, imports: rocqSourceImports(string(data))}
+		byModule[qualified] = node
+		byRel[rel] = node
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	if _, ok := byRel[invocation.sourceRel]; !ok {
+		return nil, fmt.Errorf("Rocq target source %s is unavailable", invocation.sourceRel)
+	}
+
+	state := make(map[string]uint8)
+	var plan []string
+	var visit func(string) error
+	visit = func(rel string) error {
+		switch state[rel] {
+		case 1:
+			return fmt.Errorf("Rocq local import cycle includes %s", rel)
+		case 2:
+			return nil
+		}
+		state[rel] = 1
+		node := byRel[rel]
+		imports := append([]string(nil), node.imports...)
+		sort.Strings(imports)
+		for _, imported := range imports {
+			dependency, local := byModule[imported]
+			if !local {
+				continue
+			}
+			if err := visit(dependency.rel); err != nil {
+				return err
+			}
+		}
+		state[rel] = 2
+		plan = append(plan, rel)
+		return nil
+	}
+	if err := visit(invocation.sourceRel); err != nil {
+		return nil, err
+	}
+	return plan, nil
+}
+
+func qualifiedRocqSource(sourceRel string, mappings []projectMapping) (string, bool) {
+	qualified := ""
+	bestDepth := -1
+	for _, mapping := range mappings {
+		relFromMapping, ok := pathWithinMapping(sourceRel, mapping.directory)
+		if !ok {
+			continue
+		}
+		depth := strings.Count(filepath.ToSlash(mapping.directory), "/")
+		if depth < bestDepth {
+			continue
+		}
+		modulePath := strings.TrimSuffix(filepath.ToSlash(relFromMapping), ".v")
+		qualified = mapping.logical + "." + strings.ReplaceAll(modulePath, "/", ".")
+		bestDepth = depth
+	}
+	return qualified, qualified != ""
+}
+
+func rocqSourceImports(source string) []string {
+	source = stripRocqComments(source)
+	seen := make(map[string]struct{})
+	var imports []string
+	for _, match := range rocqRequire.FindAllStringSubmatch(source, -1) {
+		prefix := strings.TrimSpace(match[1])
+		for _, name := range strings.Fields(match[2]) {
+			if !rocqModuleName.MatchString(name) {
+				continue
+			}
+			if prefix != "" {
+				name = prefix + "." + name
+			}
+			if _, exists := seen[name]; exists {
+				continue
+			}
+			seen[name] = struct{}{}
+			imports = append(imports, name)
+		}
+	}
+	return imports
+}
+
+func stripRocqComments(source string) string {
+	var result strings.Builder
+	depth := 0
+	for index := 0; index < len(source); index++ {
+		if index+1 < len(source) && source[index:index+2] == "(*" {
+			depth++
+			result.WriteString("  ")
+			index++
+			continue
+		}
+		if depth > 0 && index+1 < len(source) && source[index:index+2] == "*)" {
+			depth--
+			result.WriteString("  ")
+			index++
+			continue
+		}
+		if depth > 0 {
+			if source[index] == '\n' {
+				result.WriteByte('\n')
+			} else {
+				result.WriteByte(' ')
+			}
+			continue
+		}
+		result.WriteByte(source[index])
+	}
+	return result.String()
+}
+
+func uniqueRocqTargetSource(root, module string) (string, error) {
+	want := module + ".v"
+	var matches []string
+	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.IsDir() {
+			switch entry.Name() {
+			case ".git", ".tbci", ".codex-bridge", "_build":
+				if path != root {
+					return filepath.SkipDir
+				}
+			}
+			return nil
+		}
+		if entry.Type().IsRegular() && entry.Name() == want {
+			rel, err := filepath.Rel(root, path)
+			if err != nil {
+				return err
+			}
+			matches = append(matches, rel)
+		}
+		return nil
+	})
+	if err != nil {
+		return "", err
+	}
+	if len(matches) == 0 {
+		return "", fmt.Errorf("Rocq target source %s: %w", module, os.ErrNotExist)
+	}
+	if len(matches) != 1 {
+		return "", fmt.Errorf("Rocq target source %s is ambiguous across %d files", module, len(matches))
+	}
+	return matches[0], nil
+}
+
+func readCoqProjectMappings(root string) ([]projectMapping, error) {
+	path := filepath.Join(root, "_CoqProject")
+	info, err := os.Stat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if info.Size() > 64*1024 {
+		return nil, errors.New("_CoqProject is too large")
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	var fields []string
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		line := scanner.Text()
+		if index := strings.IndexByte(line, '#'); index >= 0 {
+			line = line[:index]
+		}
+		fields = append(fields, strings.Fields(line)...)
+	}
+	if err := scanner.Err(); err != nil {
+		return nil, err
+	}
+	var mappings []projectMapping
+	for index := 0; index < len(fields); {
+		flag := fields[index]
+		if flag != "-Q" && flag != "-R" {
+			return nil, fmt.Errorf("unsupported _CoqProject option %s", flag)
+		}
+		if index+2 >= len(fields) {
+			return nil, fmt.Errorf("incomplete _CoqProject option %s", flag)
+		}
+		directory, logical := filepath.Clean(fields[index+1]), fields[index+2]
+		if filepath.IsAbs(directory) || directory == ".." || strings.HasPrefix(directory, ".."+string(filepath.Separator)) {
+			return nil, errors.New("_CoqProject mapping escapes the workspace")
+		}
+		if !rocqModuleName.MatchString(logical) {
+			return nil, errors.New("_CoqProject logical namespace is invalid")
+		}
+		mapped := filepath.Join(root, directory)
+		if rel, err := filepath.Rel(root, mapped); err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			return nil, errors.New("_CoqProject mapping escapes the workspace")
+		}
+		mappings = append(mappings, projectMapping{directory: filepath.ToSlash(directory), logical: logical, flag: flag})
+		index += 3
+	}
+	return mappings, nil
+}
+
+func pathWithinMapping(sourceRel, directory string) (string, bool) {
+	rel, err := filepath.Rel(filepath.FromSlash(directory), filepath.FromSlash(sourceRel))
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", false
+	}
+	return rel, true
+}
