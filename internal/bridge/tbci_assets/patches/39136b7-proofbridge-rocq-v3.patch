--- /dev/null
+++ b/internal/prover/rocq/project_test.go
@@ -0,0 +1,65 @@
+package rocq
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestRocqProjectInvocationPlansNamespacedLocalImports(t *testing.T) {
+	root := t.TempDir()
+	writeRocqProjectFile(t, root, "_CoqProject", "-R . Top\n")
+	writeRocqProjectFile(t, root, "Dep.v", "Lemma helper : True. Proof. exact I. Qed.\n")
+	writeRocqProjectFile(t, root, "Main.v", "From Top Require Import Dep.\nTheorem target : True. Proof. exact helper. Qed.\n")
+
+	invocation, err := rocqProjectInvocation(root, "Main")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if invocation.qualifiedModule != "Top.Main" {
+		t.Fatalf("qualified module = %q", invocation.qualifiedModule)
+	}
+	plan, err := rocqCompilePlan(root, invocation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"Dep.v", "Main.v"}; !reflect.DeepEqual(plan, want) {
+		t.Fatalf("compile plan = %#v, want %#v", plan, want)
+	}
+}
+
+func TestRocqProjectInvocationRejectsUnsupportedProjectOption(t *testing.T) {
+	root := t.TempDir()
+	writeRocqProjectFile(t, root, "_CoqProject", "-R . Top\n-arg -w\n")
+	writeRocqProjectFile(t, root, "Main.v", "Theorem target : True. Proof. exact I. Qed.\n")
+	if _, err := rocqProjectInvocation(root, "Main"); err == nil || !strings.Contains(err.Error(), "unsupported") {
+		t.Fatalf("expected unsupported option rejection, got %v", err)
+	}
+}
+
+func TestRocqCompilePlanRejectsLocalImportCycle(t *testing.T) {
+	root := t.TempDir()
+	writeRocqProjectFile(t, root, "_CoqProject", "-Q . Top\n")
+	writeRocqProjectFile(t, root, "A.v", "From Top Require Import B.\nTheorem a : True. Proof. exact I. Qed.\n")
+	writeRocqProjectFile(t, root, "B.v", "From Top Require Import A.\nTheorem b : True. Proof. exact I. Qed.\n")
+	invocation, err := rocqProjectInvocation(root, "A")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := rocqCompilePlan(root, invocation); err == nil || !strings.Contains(err.Error(), "cycle") {
+		t.Fatalf("expected cycle rejection, got %v", err)
+	}
+}
+
+func writeRocqProjectFile(t *testing.T, root, name, content string) {
+	t.Helper()
+	path := filepath.Join(root, filepath.FromSlash(name))
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
