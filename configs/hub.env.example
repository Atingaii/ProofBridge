# Production Hub environment. Copy to /opt/codex-bridge/configs/hub.env,
# replace private values, and chmod 600. Never commit the populated file.
# The systemd Hub unit reads this file when present. For a direct launch, use
# CODEX_BRIDGE_ENV_FILE=/absolute/path/hub.env ./bin/codex-bridge hub.
# Use literal values: do not add shell commands or variable references.
# Shared with Docker --env-file: do not surround values with quotes.
# This file is not a shell script; do not source it.
APP_ENV=prod
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8088
HUB_DB_PATH=/opt/codex-bridge/data/codex-bridge.db
HUB_COOKIE_SECURE=true

# Generate once, e.g. openssl rand -hex 32. Preserve with the database on upgrade.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-bytes
# These values are used by the user command for first-time account creation.
HUB_USERNAME=admin
HUB_PASSWORD=replace-with-a-strong-private-bootstrap-password

AUTOMATION_ENABLED=true
AUTOMATION_PUBLIC_URL=https://proofbridge.example.com

# Resend SMTP. Verify the sender domain, then use a sending API key as password.
# Canonical variable documentation: docs/dev-workflow.md#environment-variables
SMTP_DELIVERY_MODE=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-with-your-resend-api-key
SMTP_FROM=ProofBridge <notify@your-verified-domain.example>
SMTP_TLS=true
SMTP_STARTTLS=false
SMTP_ALLOW_INSECURE=false
SMTP_TIMEOUT=15s
