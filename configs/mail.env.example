# Copy to a private mail.env and chmod 600 before adding credentials.
# Load explicitly with CODEX_BRIDGE_ENV_FILE=/absolute/path/mail.env.
# Existing process environment overrides this file. Values are never executed.
#
# Resend SMTP: https://resend.com/docs/send-with-smtp
# Create an API key and verify the sender domain before sending.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-with-your-resend-api-key
SMTP_FROM="ProofBridge <notify@your-verified-domain.example>"
SMTP_TLS=true
SMTP_STARTTLS=false
SMTP_ALLOW_INSECURE=false
SMTP_TIMEOUT=15s

# Brevo alternative: replace host, username and password above.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_USERNAME=copy-the-SMTP-login-from-Brevo
# SMTP_PASSWORD=use-a-Brevo-SMTP-key-not-an-API-key
# Verify the sender/domain in Brevo before sending.
