# Local Mailpit preview only; mail stays in the local test inbox.
# This does not deliver to an external recipient.
# Load explicitly with CODEX_BRIDGE_ENV_FILE=/absolute/path/mail.env.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ProofBridge Local <proofbridge@local.test>"
SMTP_TLS=false
SMTP_STARTTLS=false
SMTP_ALLOW_INSECURE=true
SMTP_TIMEOUT=15s
