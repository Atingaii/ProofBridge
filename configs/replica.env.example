# Private target-machine configuration; chmod 600 after copying to replica.env.
# Literal values only. This file is not a shell script.
APP_ENV=replica
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=18089
HUB_DB_PATH=/opt/proofbridge/data/codex-bridge.db
HUB_COOKIE_SECURE=false
JWT_SECRET=replace-with-openssl-rand-hex-32
HUB_USERNAME=admin
HUB_PASSWORD=replace-with-a-new-random-password
AUTOMATION_ENABLED=true
# Replace this example private IP with this server's actual LAN/VPN IP.
AUTOMATION_PUBLIC_URL=http://10.0.0.10:8088
# Used by Codex/Claude on this server, or through a client-side local tunnel.
AUTOMATION_MCP_URL=http://127.0.0.1:8088
# No mail is sent until SMTP is independently configured.
