# Private target-machine configuration; chmod 600 after copying to replica.env.
# Literal values only. This file is not a shell script.
APP_ENV=replica
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=18089
HUB_DB_PATH=/opt/proofbridge/data/codex-bridge.db
HUB_COOKIE_SECURE=true
JWT_SECRET=replace-with-openssl-rand-hex-32
HUB_USERNAME=admin
HUB_PASSWORD=replace-with-a-new-random-password
AUTOMATION_ENABLED=true
AUTOMATION_PUBLIC_URL=https://bridge.example.com:8088
# No mail is sent until SMTP is independently configured.
